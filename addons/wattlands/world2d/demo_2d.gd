extends Control
## world2d kit demo (BRIEF 3.9): a PixelViewport at 640 x 360 with parallax strips (one
## mirrored), meshing gears turning both ways, a flywheel with a crank-driven piston, a
## scrolling chain, palette-swapped boats in the four slot colors, wobbling fish and
## light rays, and a splash that ends in a dither dissolve. Every texture is generated by
## PixelPainter; the drive signal swings from forward to reverse every few seconds. A
## native-resolution caption is placed with art_rect_to_screen() like a HUD widget.
## tools/screenshot captures this scene.

const BASE := Vector2i(640, 360)
const SCROLL_PX_S := 24.0
const WATER_Y := 256
## The boat sprite's key ramp (light, dark): replaced by each slot's ramp.
const BOAT_KEYS: Array[Color] = [Color("#d0303c"), Color("#86202a")]

var pixel_viewport: PixelViewport = null
var view: Node2D = null
var strips: Array[ParallaxStrip] = []
var gears: Array[SpinningPart] = []
var flywheel: SpinningPart = null
var piston: SlidingPart = null
var chain: ScrollingChain = null
var boats: Array[Sprite2D] = []
var fish: Array[Sprite2D] = []
var splash: Sprite2D = null
var caption: Label = null

var _t: float = 0.0
var _drive: float = 0.0
var _gauge: DriveGauge = null


## The machine room backdrop: a riveted panel.
class MachinePanel:
	extends Node2D

	var rect: Rect2i = Rect2i(16, 96, 300, 140)

	func _draw() -> void:
		var r := Rect2(rect)
		draw_rect(r, Color("#3a2f28"))
		draw_rect(r.grow(-3), Color("#231d19"))
		draw_rect(Rect2(r.position + Vector2(3, 3), Vector2(r.size.x - 6, 10)), Color("#2e2620"))
		for x in range(rect.position.x + 6, rect.end.x - 4, 12):
			draw_rect(Rect2(x, rect.position.y + 1, 1, 1), Color("#a08c6c"))
			draw_rect(Rect2(x, rect.end.y - 2, 1, 1), Color("#a08c6c"))
		for y in range(rect.position.y + 6, rect.end.y - 4, 12):
			draw_rect(Rect2(rect.position.x + 1, y, 1, 1), Color("#a08c6c"))
			draw_rect(Rect2(rect.end.x - 2, y, 1, 1), Color("#a08c6c"))
		# Piston cylinder (a slot the piston head runs in).
		draw_rect(Rect2(226, 104, 20, 44), Color("#4a4a4e"))
		draw_rect(Rect2(229, 106, 14, 42), Color("#16141a"))


## The connecting rod from the flywheel's crank pin to the piston head.
class CrankRod:
	extends Node2D

	var wheel: SpinningPart = null
	var head: SlidingPart = null
	var pin_radius: float = 10.0

	func _process(_delta: float) -> void:
		queue_redraw()

	func _draw() -> void:
		if wheel == null or head == null:
			return
		var a := wheel.angle()
		var pin := (wheel.position + Vector2(cos(a), sin(a)) * pin_radius).floor()
		var top := (head.position + Vector2(0, 8)).floor()
		draw_line(pin + Vector2(0.5, 0.5), top + Vector2(0.5, 0.5), Color("#c9c3b8"), 2.0)
		draw_rect(Rect2(pin - Vector2(1, 1), Vector2(3, 3)), Color("#e0c27a"))


## A small -1..1 gauge of the drive signal (center line, bar left in reverse).
class DriveGauge:
	extends Node2D

	var value: float = 0.0

	func _draw() -> void:
		draw_rect(Rect2(0, 0, 81, 5), Color("#16141a"))
		draw_rect(Rect2(40, -1, 1, 7), Color("#c9c3b8"))
		var w := roundf(absf(value) * 39.0)
		if value >= 0.0:
			draw_rect(Rect2(41, 1, w, 3), Color("#7fc06a"))
		else:
			draw_rect(Rect2(40 - w, 1, w, 3), Color("#e0663a"))


func _ready() -> void:
	set_anchors_preset(Control.PRESET_FULL_RECT)
	pixel_viewport = PixelViewport.new()
	pixel_viewport.pixel_base = BASE
	pixel_viewport.background_color = Color("#10141c")
	add_child(pixel_viewport)
	view = Node2D.new()
	view.name = "DemoView"
	pixel_viewport.set_game_view(view)
	_build_landscape()
	_build_water()
	_build_boats()
	_build_machine()
	_build_caption()
	pixel_viewport.layout_changed.connect(_place_caption)
	_place_caption()


func _process(delta: float) -> void:
	_t += delta
	# Forward, ease off, reverse, back: shows both directions of every part.
	_drive = clampf(sin(_t * 0.45) * 1.15, -1.0, 1.0)
	var world_x := _t * SCROLL_PX_S
	for s: ParallaxStrip in strips:
		s.world_x = world_x
	for g: SpinningPart in gears:
		g.speed = _drive
	flywheel.speed = _drive
	piston.speed = _drive
	chain.speed = _drive
	_gauge.value = _drive
	_gauge.queue_redraw()
	# A splash every 3 s that ends in a dither dissolve.
	var life := fmod(_t, 3.0)
	splash.visible = life < 1.6
	DitherDissolve.set_amount(
		splash.material as ShaderMaterial, clampf((life - 0.6) / 1.0, 0.0, 1.0)
	)
	for i in fish.size():
		var f := fish[i]
		var v := 14.0 if i == 0 else 9.0
		f.position.x -= v * delta
		if f.position.x < -40.0:
			f.position.x = float(BASE.x) + 40.0


func _build_landscape() -> void:
	var sky := Sprite2D.new()
	sky.centered = false
	sky.texture = PixelPainter.texture(
		PixelPainter.vertical_gradient(BASE.x, WATER_Y, Color("#3f7fcf"), Color("#f4cf98"), 9)
	)
	view.add_child(sky)

	var sun := Sprite2D.new()
	sun.texture = PixelPainter.texture(PixelPainter.disc(11, Color("#fff1c4"), Color("#ffd27a")))
	sun.position = Vector2(500, 70)
	view.add_child(sun)

	strips.append(_strip(_cloud_image(), 0.06, true, 28.0, false))
	strips[0].drift_px_s = 3.0
	var far := PixelPainter.hill_heights(160, 70, 3, 0.45, 0.32)
	strips.append(
		_strip(
			PixelPainter.silhouette(160, 70, far, Color("#8297b0"), Color("#a8bad0")),
			0.2,
			true,
			236.0,
			true
		)
	)
	var near := PixelPainter.hill_heights(208, 60, 11, 0.55, 0.38)
	strips.append(
		_strip(
			PixelPainter.silhouette(208, 60, near, Color("#56704a"), Color("#7a9a5c")),
			0.5,
			true,
			244.0,
			true
		)
	)
	var shore := PixelPainter.bands(
		48, 14, PackedColorArray([Color("#c7a15a"), Color("#b38d4c"), Color("#dcc79c")]), 3
	)
	strips.append(_strip(shore, 1.0, false, float(WATER_Y), true))


func _build_water() -> void:
	var water := Sprite2D.new()
	water.centered = false
	water.position = Vector2(0, WATER_Y)
	water.texture = PixelPainter.texture(
		PixelPainter.vertical_gradient(
			BASE.x, BASE.y - WATER_Y, Color("#2a93c4"), Color("#0b2f5c"), 7
		)
	)
	view.add_child(water)

	var rays := Sprite2D.new()
	rays.centered = false
	rays.position = Vector2(300, WATER_Y + 2)
	rays.texture = PixelPainter.texture(_rays_image(160, 96))
	SpriteWobble.water(rays, 2.0, 0.4)
	view.add_child(rays)

	var crest := (
		PixelPainter
		. from_rows(
			PackedStringArray(
				[
					"..WW......WWW...",
					"WWccWWWWWWcccWWW",
					"cccccccccccccccc",
				]
			),
			{"W": Color("#e8f6ff"), "c": Color("#5fb6dc")}
		)
	)
	strips.append(_strip(crest, 1.0, true, float(WATER_Y) - 1.0, false))

	var mackerel := (
		PixelPainter
		. from_rows(
			PackedStringArray(
				[
					"......nnnnnnnn..........",
					"....nnbbBbbBbbnnn....nn.",
					"..nnbbbbbbbbbbbbbnnnnbn.",
					".nWkbbbbBbbBbbBbbbbbbbn.",
					".nnssssssssssssssssnnbbn",
					"..nnssssssssssssnnn..nnn",
					"....nnnnnnnnnnnn........",
				]
			),
			{
				"n": Color("#1c2340"),
				"b": Color("#2f6fa8"),
				"B": Color("#1d4a7a"),
				"s": Color("#cfe3ea"),
				"W": Color("#ffffff"),
				"k": Color("#000000")
			}
		)
	)
	var tuna := (
		PixelPainter
		. from_rows(
			PackedStringArray(
				[
					"..........nnnnnnnnn...............",
					".......nnnbbbbbbbbbnnn.........nn.",
					".....nnbbbbbbbbbbbbbbbnnn....nnbn.",
					"...nnbbbbbbbbbbbbbbbbbbbbnnnnbbn..",
					"..nWkbbbbbbbbbbbbbbbbbbbbbbbbbbn..",
					".nnsssssssssssssssyysyysyysnnbbbn.",
					"..nnsssssssssssssssssssssnn..nnbbn",
					"....nnnsssssssssssssssnnn......nnn",
					".......nnnnnnnnnnnnnnn............",
				]
			),
			{
				"n": Color("#141a33"),
				"b": Color("#24406e"),
				"s": Color("#c3cdd6"),
				"y": Color("#f2c230"),
				"W": Color("#ffffff"),
				"k": Color("#000000")
			}
		)
	)
	for i in 2:
		var f := Sprite2D.new()
		f.centered = false
		f.texture = PixelPainter.texture(mackerel if i == 0 else tuna)
		f.position = Vector2(180.0 + 260.0 * i, 292.0 + 34.0 * i)
		SpriteWobble.fish_tail(f, true, 1.0, 2.5 if i == 0 else 1.6)
		view.add_child(f)
		fish.append(f)
	splash = Sprite2D.new()
	splash.centered = false
	splash.position = Vector2(560, WATER_Y - 14)
	splash.texture = (
		PixelPainter
		. texture(
			(
				PixelPainter
				. from_rows(
					PackedStringArray(
						[
							"......w.....w.......",
							"..w....w...w....w...",
							"...w..wWw.wWw..w....",
							"....wWWWWwWWWWw.....",
							"..wWWWccWWWccWWWw...",
							".wWWccccWWccccWWWw..",
							"wWccccccccccccccWWw.",
						]
					),
					{"W": Color("#ffffff"), "w": Color("#cfefff"), "c": Color("#7cc8e8")}
				)
			)
		)
	)
	DitherDissolve.apply(splash)
	view.add_child(splash)


func _build_boats() -> void:
	var boat := (
		PixelPainter
		. from_rows(
			PackedStringArray(
				[
					"........RRRRRRRRRRRR........",
					"........rrrrrrrrrrrr........",
					"........k..........k........",
					"........k..........k...k....",
					"..nWWWWWWWWWWWWWWWWWWWWWWn..",
					"..nWWWWWWWWWWWWWWWWWWWWWWWn.",
					"...RRRRRRRRRRRRRRRRRRRRRRRn.",
					"...nWWWWWWWWWWWWWWWWWWWWWn..",
					"....nwwwwwwwwwwwwwwwwwwwn...",
					".....nrrrrrrrrrrrrrrrrrn....",
					"......nnnnnnnnnnnnnnnnn.....",
				]
			),
			{
				"R": BOAT_KEYS[0],
				"r": BOAT_KEYS[1],
				"W": Color("#f4f4ee"),
				"w": Color("#c9cfd4"),
				"k": Color("#3a3a40"),
				"n": Color("#1c2340")
			}
		)
	)
	var tex := PixelPainter.texture(boat)
	var keys := PackedColorArray(BOAT_KEYS)
	for slot in 4:
		var bob := SlidingPart.new()
		bob.axis = Vector2.UP
		bob.travel_px = 1.0
		bob.max_cps = 0.5
		bob.phase = 0.27 * slot
		bob.speed = 1.0
		bob.position = Vector2(352 + 72 * slot, WATER_Y - 9)
		view.add_child(bob)
		var s := Sprite2D.new()
		s.centered = false
		s.texture = tex
		PaletteSwap.apply_slot(s, keys, slot)
		bob.add_child(s)
		boats.append(s)
	var reeds := Image.create_empty(96, 22, false, Image.FORMAT_RGBA8)
	reeds.fill(Color(0, 0, 0, 0))
	var stems: Array[int] = [3, 6, 7, 11, 40, 43, 47, 48, 52, 80, 84, 85]
	for i in stems.size():
		var x := stems[i]
		var h := 10 + (i * 7) % 12
		for y in range(22 - h, 22):
			reeds.set_pixel(x, y, Color("#2f4a28") if (x + y) % 5 != 0 else Color("#4f6f38"))
	strips.append(_strip(reeds, 1.3, false, float(WATER_Y) + 2.0, true))


func _build_machine() -> void:
	var panel := MachinePanel.new()
	view.add_child(panel)
	var bronze := PixelPainter.gear(24, 12, Color("#b98c46"), Color("#5c4127"), Color("#e0c27a"), 3)
	var steel := PixelPainter.gear(13, 6, Color("#8e8983"), Color("#4a4a4e"), Color("#c9c3b8"), 3)
	var big := _gear(bronze, Vector2(64, 170), 40.0, 1.0)
	var small := _gear(steel, Vector2(99, 170), 40.0, -2.0)
	small.phase_deg = 15.0
	gears.append(big)
	gears.append(small)

	flywheel = SpinningPart.new()
	flywheel.texture = PixelPainter.texture(
		PixelPainter.gear(28, 28, Color("#6f6a64"), Color("#3a3a40"), Color("#b98c46"), 1)
	)
	flywheel.position = Vector2(236, 176)
	flywheel.max_rpm = 40.0
	flywheel.inertia_s = 0.6
	view.add_child(flywheel)

	piston = SlidingPart.new()
	piston.axis = Vector2.UP
	piston.travel_px = 20.0
	piston.max_cps = flywheel.max_rpm / 60.0
	piston.inertia_s = flywheel.inertia_s
	piston.phase = -0.25
	piston.pixel_snap = false
	var head := Sprite2D.new()
	head.centered = false
	head.position = Vector2(-6, 0)
	head.texture = (
		PixelPainter
		. texture(
			(
				PixelPainter
				. from_rows(
					PackedStringArray(
						[
							"kkkkkkkkkkkk",
							"kssssssssssk",
							"kSSSSSSSSSSk",
							"kssssssssssk",
							"kSSSSSSSSSSk",
							"kssssssssssk",
							"kkkkkkkkkkkk",
							"....kkkk....",
						]
					),
					{"k": Color("#3a3a40"), "s": Color("#c9c3b8"), "S": Color("#8e8983")}
				)
			)
		)
	)
	piston.add_child(head)
	piston.position = Vector2(236, 176 + 10 - 40)
	view.add_child(piston)

	var rod := CrankRod.new()
	rod.wheel = flywheel
	rod.head = piston
	view.add_child(rod)

	# Sprockets first, so the chain draws over their teeth.
	var chain_px_s := 36.0
	var sprocket_r := 9.0
	var sprocket_rpm := chain_px_s / (TAU * sprocket_r) * 60.0
	for c: Vector2 in [Vector2(122, 208), Vector2(196, 208)]:
		var sp := _gear(
			PixelPainter.gear(10, 10, Color("#8e8983"), Color("#3a3a40"), Color("#c9c3b8"), 2),
			c,
			sprocket_rpm,
			1.0
		)
		gears.append(sp)
	chain = ScrollingChain.new()
	chain.set_loop(Vector2(122, 208), sprocket_r, Vector2(196, 208), sprocket_r)
	chain.max_px_s = chain_px_s
	chain.pitch_px = 3.0
	chain.link_px = 2.0
	chain.color_a = Color("#d8d2c4")
	chain.color_b = Color("#7d766c")
	view.add_child(chain)

	_gauge = DriveGauge.new()
	_gauge.position = Vector2(26, 224)
	view.add_child(_gauge)


func _build_caption() -> void:
	caption = Label.new()
	caption.add_theme_font_size_override("font_size", 28)
	caption.add_theme_color_override("font_color", Color("#fff6e0"))
	caption.add_theme_color_override("font_outline_color", Color("#10141c"))
	caption.add_theme_constant_override("outline_size", 8)
	caption.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	caption.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	caption.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(caption)


func _place_caption() -> void:
	if caption == null:
		return
	var r := pixel_viewport.art_rect_to_screen(Rect2i(392, 6, 240, 18))
	caption.position = r.position
	caption.size = r.size
	caption.text = (
		tr("WORLD_DEMO_2D_CAPTION")
		. format(
			{
				"w": BASE.x,
				"h": BASE.y,
				"scale": pixel_viewport.integer_scale(),
			}
		)
	)


func _strip(img: Image, factor: float, mirror: bool, y: float, bottom: bool) -> ParallaxStrip:
	var s := ParallaxStrip.new()
	s.texture = PixelPainter.texture(img)
	s.factor = factor
	s.mirror_alternate = mirror
	s.align_bottom = bottom
	s.position = Vector2(0, y)
	s.cover_width = float(BASE.x)
	view.add_child(s)
	return s


func _gear(img: Image, at: Vector2, rpm: float, ratio: float) -> SpinningPart:
	var g := SpinningPart.new()
	g.texture = PixelPainter.texture(img)
	g.position = at
	g.max_rpm = rpm
	g.ratio = ratio
	view.add_child(g)
	return g


func _cloud_image() -> Image:
	var img := Image.create_empty(160, 30, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var puffs: Array[Vector3] = [
		Vector3(18, 20, 8),
		Vector3(30, 16, 11),
		Vector3(44, 20, 8),
		Vector3(96, 14, 7),
		Vector3(108, 10, 10),
		Vector3(122, 14, 8),
		Vector3(134, 18, 6),
	]
	for y in img.get_height():
		for x in img.get_width():
			for p: Vector3 in puffs:
				var d := Vector2(x + 0.5 - p.x, (y + 0.5 - p.y) * 1.3).length()
				if d <= p.z:
					var shade := y > int(p.y) + int(p.z * 0.35)
					img.set_pixel(x, y, Color("#e4e9f2") if shade else Color("#ffffff"))
	return img


func _rays_image(w: int, h: int) -> Image:
	var img := Image.create_empty(w, h, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in h:
		var fade := 1.0 - float(y) / float(h)
		for x in w:
			var band := fposmod(float(x) + float(y) * 0.45, 26.0)
			if band < 5.0:
				img.set_pixel(x, y, Color(0.85, 0.95, 1.0, 0.22 * fade))
	return img
