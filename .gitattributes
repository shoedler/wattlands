# Keep LF in the repo and in every checkout, including the build's git worktrees,
# so bash scripts such as tools/godot.sh keep working under Git Bash on Windows.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.fit binary
