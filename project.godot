; Engine configuration file.
; Owned by the lead (BRIEF 6). Agents request changes (autoloads, actions, settings) in
; their reports; autoload names never change.

config_version=5

[application]

config/name="WATTLANDS"
config/description="Multiplayer fitness party games for the KICKR CORE smart trainer."
config/version="0.9.3"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://src/app/icon.svg"

[autoload]

EventBus="*res://addons/wattlands/contracts/event_bus.gd"
Settings="*res://addons/wattlands/core/settings.gd"
InputRouter="*res://addons/wattlands/ui/input_router.gd"
TrainerService="*res://addons/wattlands/core/trainer_service.gd"
NetSession="*res://addons/wattlands/net/net_session.gd"
GameRegistry="*res://addons/wattlands/sdk/game_registry.gd"
Rides="*res://addons/wattlands/rides/rides_service.gd"
Sfx="*res://addons/wattlands/audio/sfx.gd"
App="*res://addons/wattlands/core/app_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": true
}

